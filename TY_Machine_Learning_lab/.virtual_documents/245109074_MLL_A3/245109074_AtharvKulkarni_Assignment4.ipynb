bm_max=bm/bm.max()
bm_mm=(bm-bm.min())/(bm.max()-bm.min())
bm_z=(bm-bm.mean())/bm.std()
Q1_bm,Q3_bm=bm.quantile(0.25),bm.quantile(0.75)
bm_iqr=(bm-bm.median())/(Q3_bm-Q1_bm)
fig,ax=plt.subplots(2,3,figsize=(15,8))
