def strip_unit(val):
    if pd.isna(val):
        return np.nan
    s=str(val).strip()
    if s in [".",""]:
        return np.nan
    m=re.search(r"[-+]?\d*\.?\d+",s)
    if m:
        return float(m.group())
    return np.nan


df["height_cm"]=df["height_cm"].apply(strip_unit)
df["weight_kg"]=df["weight_kg"].apply(strip_unit)

